# Secrets for Terraform + doctl. Copy this to `infra/terraform/.env` (which is gitignored)
# and fill in your real values. NEVER commit the real .env, and do NOT paste these values
# into chat — edit the .env file yourself.
#
#   cp infra/terraform/.env.example infra/terraform/.env
#   # edit infra/terraform/.env with your token
#
# Terraform/doctl read these from the environment. Each apply is run as:
#   set -a; source infra/terraform/.env; set +a; terraform apply

# DigitalOcean API token. Needs scopes: kubernetes, databases, vpc, registry
# (+ read on regions/sizes/account). A full read+write PAT also works.
export DIGITALOCEAN_TOKEN="dop_v1_REPLACE_ME"

# Spaces keys — ONLY needed if we keep the Spaces artifacts bucket. These are
# separate S3-style keys (DO console → API → Spaces Keys), NOT the API token.
# Delete these two lines if we drop Spaces.
export SPACES_ACCESS_KEY_ID="REPLACE_ME"
export SPACES_SECRET_ACCESS_KEY="REPLACE_ME"
