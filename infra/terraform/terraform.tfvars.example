# Copy to terraform.auto.tfvars (gitignored) and adjust. NO secrets here —
# the DO API token + Spaces keys come from environment variables:
#   export DIGITALOCEAN_TOKEN=...
#   export SPACES_ACCESS_KEY_ID=...
#   export SPACES_SECRET_ACCESS_KEY=...

project_name = "doomberg"
environment  = "dev"
region       = "nyc3"

kubernetes_version = "1.31"

# RELIABILITY-FIRST, HA, CPU-only. Budget is generous; optimize for uptime.

# Backtest pool: WARM floor (min 1, no cold start) bursting to max under load.
# MUST be a CPU slug — GPU slugs (gpu-*/p-*) fail the plan (CPU-ONLY GUARDRAIL).
backtest_node_size = "c-4"
backtest_node_min  = 1
backtest_node_max  = 8

# Always-on HA pool: gateways + scheduler. >=2 nodes (node-failover safe).
paper_node_size  = "s-4vcpu-8gb"
paper_node_count = 2

# Managed Postgres HA: node_count 2 = primary + standby (automatic failover).
postgres_version    = "16"
postgres_size       = "db-s-2vcpu-4gb"
postgres_node_count = 2

# Container Registry (DOCR) — the single multi-service image.
registry_name              = "doomberg"
registry_subscription_tier = "professional"

# Public HA Load Balancer -> always-on gateways.
lb_size_unit = 2

# One-shot archive loader (seeds archive.* on first deploy; set false after).
enable_archive_load_job = true

spaces_bucket_name = "doomberg-artifacts"

vpc_ip_range = "10.20.0.0/20"

backtest_active_deadline_seconds   = 1800
paper_tick_active_deadline_seconds = 120
paper_tick_schedule                = "*/5 13-21 * * 1-5"
