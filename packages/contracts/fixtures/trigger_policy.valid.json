{
  "version": "trigger.policy.v1",
  "when": {
    "event": "market.quote",
    "universe": ["NVDA"],
    "baseline": {
      "type": "previous_close"
    }
  },
  "condition": {
    "all": [
      { "change_pct": { "lte": -2.0 } },
      { "data_freshness_seconds": { "lte": 10 } }
    ]
  },
  "controls": {
    "dedupe_key": "${trigger_id}:${symbol}:${trading_day}:down2",
    "cooldown": "30m",
    "max_runs_per_day": 8,
    "require_connected_live_data": true,
    "approval_required": false
  },
  "action": {
    "mode": "analyze",
    "run_skill": "market.news",
    "input": {
      "limit": 10
    }
  },
  "notify": {
    "channels": ["doomberg_ui", "claude_channel", "webhook"],
    "priority": "high"
  }
}
