{
  "name": "doomberg-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "description": "Doomberg v2 — a financial tool-platform external agents call via MCP, with a paper-trading deploy layer and dashboard.",
  "scripts": {
    "test:ts": "pnpm -r --if-present run test",
    "typecheck:ts": "pnpm -r --if-present run typecheck",
    "contracts:codegen": "bash packages/contracts/scripts/codegen.sh",
    "contracts:check": "bash packages/contracts/scripts/check_drift.sh"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "vite": "6.4.3",
      "esbuild": "0.25.0"
    }
  }
}
