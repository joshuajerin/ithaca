# Dedicated IBKR engine image. It contains:
# - the official IBKR Client Portal Gateway zip downloaded at build time
# - the Doomberg FastAPI wrapper that normalizes gateway responses for the app/MCP/workers
FROM python:3.12-slim AS builder

RUN pip install --no-cache-dir uv==0.7.13

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=120 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages/contracts/py/pyproject.toml packages/contracts/py/
COPY doomberg-core/pyproject.toml doomberg-core/
COPY services/data-archive/pyproject.toml services/data-archive/
COPY services/platform/pyproject.toml services/platform/
COPY services/mcp-gateway/pyproject.toml services/mcp-gateway/
COPY services/control-plane/pyproject.toml services/control-plane/
COPY services/rest-gateway/pyproject.toml services/rest-gateway/
COPY services/runtime/pyproject.toml services/runtime/
COPY services/ibkr-engine/pyproject.toml services/ibkr-engine/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-workspace --package doomberg-ibkr-engine

COPY packages/contracts/py/ packages/contracts/py/
COPY doomberg-core/ doomberg-core/
COPY services/ibkr-engine/ services/ibkr-engine/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package doomberg-ibkr-engine

FROM eclipse-temurin:17-jre-jammy AS gateway

ARG IBKR_GATEWAY_ZIP_URL="https://download2.interactivebrokers.com/portal/clientportal.gw.zip"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/clientportal

RUN curl -fsSL "${IBKR_GATEWAY_ZIP_URL}" -o /tmp/clientportal.gw.zip \
    && unzip -q /tmp/clientportal.gw.zip -d /opt/clientportal \
    && rm /tmp/clientportal.gw.zip \
    && chmod +x /opt/clientportal/bin/run.sh \
    && cp -a /opt/clientportal/root /opt/clientportal-root-template

FROM python:3.12-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates default-jre-headless \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 doomberg \
    && useradd --system --uid 10001 --gid doomberg --home-dir /app --no-create-home doomberg

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CLIENT_PORTAL_HOME=/opt/clientportal \
    CLIENT_PORTAL_STATE=/opt/clientportal/root \
    CLIENT_PORTAL_TEMPLATE=/opt/clientportal-root-template \
    IBKR_CLIENT_PORTAL_URL=https://127.0.0.1:5000/v1/api \
    IBKR_CLIENT_PORTAL_VERIFY_SSL=false \
    DOOMBERG_IBKR_ENGINE_PORT=8090

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app/doomberg-core /app/doomberg-core
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/services/ibkr-engine /app/services/ibkr-engine
COPY --from=gateway /opt/clientportal /opt/clientportal
COPY --from=gateway /opt/clientportal-root-template /opt/clientportal-root-template
COPY deploy/ibkr_engine_entrypoint.sh /usr/local/bin/ibkr_engine_entrypoint.sh
COPY deploy/ibkr-conf.yaml /usr/local/share/doomberg/ibkr-conf.yaml

RUN chmod +x /usr/local/bin/ibkr_engine_entrypoint.sh \
    && chown -R doomberg:doomberg /opt/clientportal /opt/clientportal-root-template /app

USER doomberg

ENTRYPOINT ["/usr/local/bin/ibkr_engine_entrypoint.sh"]
CMD ["ibkr-engine"]
