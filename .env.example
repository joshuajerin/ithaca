# ---------------------------------------------------------------------------
# Shared environment for doomberg.me + kural.website (Vercel project: doomberg)
# ---------------------------------------------------------------------------
# Copy to Vercel project env vars. Server-side functions read these. Do NOT
# prefix the Hermes/Supabase secrets with VITE_ — that would leak them to the
# browser bundle.

# --- Hermes AI backend (shared tunnel, per-site keys) ---
# Public URL of the Hermes custom-endpoint tunnel (cloudflared trycloudflare or
# a stable Cloudflare Tunnel hostname).
HERMES_BASE_URL=https://urban-baseball-nerve-offices.trycloudflare.com
# Per-site bearer keys for the Hermes /doomberg and /kural endpoints.
DOOMBERG_HERMES_KEY=replace-with-doomberg-endpoint-key
KURAL_HERMES_KEY=replace-with-kural-endpoint-key
# Optional upstream timeout (ms). Default 120000.
# HERMES_TIMEOUT_MS=120000

# --- Shared Supabase project (one DB, `site` column scopes both sites) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Public anon values may be exposed to the browser if a site does direct
# client-side inserts (leads/events). Safe to VITE_-prefix these two ONLY.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-with-anon-key
