# Doomberg product/runtime environment. Copy the relevant values into your local
# shell, VPS service unit, or infra/terraform/.env before deploying.

# Shared system-of-record. Local dev can use SQLite; customer/prod should use
# managed Postgres.
DOOMBERG_ENV=local
DOOMBERG_DB=./doomberg.db
# DOOMBERG_DB=postgresql://user:pass@host:5432/dbname?sslmode=require
DOOMBERG_SESSION_SECRET=replace-with-long-random-secret
DOOMBERG_ADMIN_TOKEN=

# Hosted URLs. Used by launch gates and external checks.
DOOMBERG_REST_URL=http://localhost:8000
DOOMBERG_MCP_URL=http://localhost:8080/mcp
DOOMBERG_API_KEY=
DOOMBERG_MCP_NO_SCOPE_API_KEY=

# Clerk auth. The VITE key is public and is baked into the web bundle. The
# backend verifies Clerk session JWTs with either the PEM public key or JWKS URL.
# CLERK_SECRET_KEY lets Clerk manage agent/MCP API keys and waitlist approvals.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PEM_PUBLIC_KEY=
CLERK_JWKS_URL=
CLERK_ALLOWED_ORIGINS=http://localhost:5174
CLERK_ISSUER=
CLERK_API_URL=https://api.clerk.com/v1
CLERK_API_VERSION=2026-05-12
VITE_API_BASE=/api

# Public marketing-site origin. The web app links to legal/policy pages hosted
# on the marketing site (e.g. /terms, /privacy). Defaults to https://doomberg.me.
VITE_SITE_URL=https://doomberg.me

# Optional archive/reference providers.
FMP_API_KEY=

# Databento: institutional-grade, point-in-time historical market data.
# When set, the DataGateway uses Databento instead of Yahoo for backtests
# and paper trading. Set DOOMBERG_DATA_SOURCE=databento to force it, or
# auto (default) to use Databento when the key is present.
DATABENTO_API_KEY=
DATABENTO_DATASET=XNAS.ITCH
# DOOMBERG_DATA_SOURCE=auto

# User-run IBKR engine on the VPS. The default quote route is:
#   GET /quote?symbol=AAPL
DOOMBERG_IBKR_ENGINE_URL=
DOOMBERG_IBKR_ENGINE_TOKEN=
DOOMBERG_IBKR_QUOTE_PATH=/quote?symbol={symbol}
DOOMBERG_IBKR_SMOKE_MAX_FRESHNESS_MS=60000

# Optional IBKR read-model route overrides for MCP broker tools.
DOOMBERG_IBKR_ACCOUNTS_PATH=/accounts
DOOMBERG_IBKR_POSITIONS_PATH=/positions?account={account}
DOOMBERG_IBKR_ORDERS_PATH=/orders?account={account}

# Live broker submission is disabled unless this is explicitly enabled and the
# tenant has a connected provider row with orders/trading/execution capability.
DOOMBERG_ENABLE_LIVE_EXECUTION=0
DOOMBERG_IBKR_ORDER_PATH=/orders
DOOMBERG_EXECUTION_MAX_NOTIONAL_USD=10000
DOOMBERG_EXECUTION_MAX_QUANTITY=10000
DOOMBERG_EXECUTION_MAX_FRESHNESS_MS=10000

# Managed IBKR engine deployment on DOKS. deploy/deploy_services.sh defaults
# DOOMBERG_IBKR_ENGINE_URL to the internal ClusterIP service when enabled.
IBKR_ENGINE_ENABLED=1
IBKR_ENGINE_IMAGE=
IBKR_ENGINE_PORT=8090
IBKR_ENGINE_STORAGE_SIZE=2Gi

# Temporary customer sign-in route. Keep disabled by default. Enable only during
# the sign-in window, then deploy again with IBKR_SIGNIN_PUBLIC=0 so only the
# cluster-internal service can reach the IBKR gateway/API.
IBKR_SIGNIN_PUBLIC=0
IBKR_SIGNIN_HOST=ibkr.doomberg.me
IBKR_SIGNIN_REMOTE_IPS=0.0.0.0/0

# Worker cadence.
DOOMBERG_BACKTEST_INTERVAL_S=2
DOOMBERG_TRIGGER_JOB_INTERVAL_S=2
DOOMBERG_TRIGGER_INTERVAL_S=5
DOOMBERG_PAPER_INTERVAL_S=60
DOOMBERG_MARKET_HOURS=0
