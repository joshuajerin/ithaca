{
  "name": "@doomberg/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Doomberg v2 observability UI — React + Vite + TS. Consumes the rest-gateway REST+SSE only (never MCP). No chat console.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@doomberg/contracts": "workspace:*",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-slider": "^1.4.1",
    "@tailwindcss/vite": "^4.3.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "html2canvas-pro": "^2.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "recharts": "^3.8.1",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
