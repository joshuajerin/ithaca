# Doomberg web (dashboard) — Clerk + gateway config.
# Copy to .env.local and fill in the publishable key for this environment.

# REST/SSE gateway base (defaults to same-origin /api).
VITE_API_BASE=/api
# Hosted MCP endpoint shown in agent handoff/settings views.
VITE_MCP_BASE=https://mcp.doomberg.me/mcp
# Local-dev tenant (UUID) sent as X-Tenant-Id.
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001

# Clerk publishable key for the current Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=
