# Doomberg web (dashboard) — OAuth + gateway config.
# Copy to .env.local and fill in. Without client ids, the auth page falls back
# to a demo session so the app is usable immediately.

# REST/SSE gateway base (defaults to same-origin /api).
VITE_API_BASE=/api
# Local-dev tenant (UUID) sent as X-Tenant-Id.
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- OAuth (authorization-code flow; token exchange happens on the backend) ---
# Google: create an OAuth 2.0 Web client; add the redirect URI below.
VITE_GOOGLE_CLIENT_ID=
# GitHub: register an OAuth App; set its Authorization callback URL to the redirect below.
VITE_GITHUB_CLIENT_ID=
# Redirect URI both providers send the code back to (a real path, not a hash).
# Must be registered with each provider. Defaults to <origin>/auth/callback.
VITE_OAUTH_REDIRECT=http://localhost:5173/auth/callback

# Backend the callback posts the code to (implement in rest-gateway):
#   POST {VITE_API_BASE}/auth/{google|github}/exchange  { code, redirect_uri }
#     -> 200 { user: { id, name, email, avatarUrl?, provider } }
# The client SECRET lives only on the backend — never in this app.
